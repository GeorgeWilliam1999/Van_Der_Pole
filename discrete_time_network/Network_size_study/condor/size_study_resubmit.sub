# The network-size sweep: one job per (depth, width, seed) from params.txt.
# Widest/deepest combos are listed first so the slow jobs start earliest.
universe              = vanilla
executable            = /data/bfys/gscriven/conda/envs/TE/bin/python
arguments             = "train_size.py --depth $(depth) --width $(width) --seed $(seed)"
initialdir            = /data/bfys/gscriven/Van_Der_Pole/discrete_time_network/Network_size_study
output                = condor/logs/d$(depth)_w$(width)_s$(seed).out
error                 = condor/logs/d$(depth)_w$(width)_s$(seed).err
log                   = condor/logs/size_study.log
should_transfer_files = NO
getenv                = False
environment           = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4"
request_cpus          = 4
request_memory        = 6G
+UseOS                = "el9"
+JobCategory          = "medium"
queue depth, width, seed from condor/params_missing.txt
